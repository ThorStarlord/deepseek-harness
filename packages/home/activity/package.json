  "version": "0.2.2-rc.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/home/activity"
  },
  "type": "module",
  "main": "lib/index.js",
